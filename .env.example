# Django
DEBUG=0
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SECURE_SSL_REDIRECT=0
# Enable only after confirming the site and all subdomains work over HTTPS.
SECURE_HSTS_SECONDS=0
# Allow http:// / localhost / private-IP webhook endpoints (local dev only).
# Defaults to DEBUG; never set to 1 in production — it disables the SSRF guard.
WEBHOOK_ALLOW_INSECURE_URLS=0

# Background workers — `manage.py run_workers` runs these in one process.
# Poll intervals in seconds (optional; sane defaults shown).
WORKER_PENDING_PAYMENTS_INTERVAL=15
WORKER_RECONCILE_INTERVAL=20
WORKER_WEBHOOKS_INTERVAL=10

# PostgreSQL (omit POSTGRES_DB to use SQLite locally)
POSTGRES_DB=amatopay
POSTGRES_USER=amatopay
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_SSLMODE=prefer
LOG_LEVEL=INFO
SECURITY_DB_NAME=/app/security-data/security.sqlite3

# Encrypts payer delivery codes saved with collections. Generate with:
# python -m apps.gateway.release_codes
# Put the newest key first; retain older comma-separated keys during rotation.
RELEASE_CODE_ENCRYPTION_KEYS=

# Fiduciary release policy
DOMESTIC_HOLD_BUSINESS_DAYS=4
INTERNATIONAL_HOLD_CALENDAR_DAYS=14

# Brand & contact (shown across the public site and dashboard templates)
COMPANY_NAME=AmatoPay
SUPPORT_EMAIL=ndiku6241@gmail.com
# SALES_EMAIL=
# DEVELOPERS_EMAIL=
# SUPPORT_PHONE=
# PUBLIC_API_BASE_URL=https://api.amatopay.bi
# PUBLIC_SITE_URL=https://amatopay.bi
