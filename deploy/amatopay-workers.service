[Unit]
Description=AmatoPay background workers (run_workers)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=amatopay
Group=amatopay

# Absolute path to the project checkout.
WorkingDirectory=/opt/amatopay

# .env is loaded by config/env.py, but systemd can also inject it:
EnvironmentFile=/opt/amatopay/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings

ExecStart=/opt/amatopay/venv/bin/python manage.py run_workers

# run_workers traps SIGTERM and drains its threads (join timeout 30s).
KillSignal=SIGTERM
TimeoutStopSec=45

Restart=on-failure
RestartSec=5

# Hardening (loosen if your deploy needs more).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
